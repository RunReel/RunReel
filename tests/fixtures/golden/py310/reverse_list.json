  "file": "reverse_list.py",
  "text": "class Node:\n    def __init__(self, value, next=None):\n        self.value = value\n        self.next = next\n\n\ndef build(values):\n    \"\"\"A linked list holding values in order, built front to back.\"\"\"\n    head = tail = None\n    for value in values:\n        node = Node(value)\n        if tail is None:\n            head = node\n        else:\n            tail.next = node\n        tail = node\n    return head\n\n\ndef reverse(head):\n    \"\"\"Reverse a linked list in place, turning its next pointers round one at a time.\"\"\"\n    prev = None\n    cur = head\n    while cur is not None:\n        nxt = cur.next\n        cur.next = prev\n        prev = cur\n        cur = nxt\n    return prev\n\n\nif __name__ == \"__main__\":\n    node = reverse(build([1, 2, 3, 4, 5]))\n    while node is not None:\n        print(node.value)\n        node = node.next\n",
  "entry": "reverse(build([1, 2, 3, 4, 5]))"
